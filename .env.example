# Shipyard OS — Environment Configuration
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# The setup wizard (npm run dev → /setup) will auto-create .env.local for you.

# ── Agent Runtime ────────────────────────────────────────────────
# Which runtime to use: "openclaw", "ollama", or "demo"
AGENT_RUNTIME=openclaw

# ── Inference Layer (per-agent models via Vercel AI SDK) ──────────
# Format: <provider>/<model-id>. Providers: anthropic, nous, ollama, shipyard.
# Per-agent overrides win over AGENT_MODEL; unset = runtime pipeline.
#
# Examples:
#   AGENT_MODEL=shipyard/claude-sonnet-4-5
#   AGENT_MODEL_VIC=shipyard/claude-sonnet-4-5
#   AGENT_MODEL_SCOUT=nous/xiaomi/mimo-v2-pro
#   AGENT_MODEL_BUILDER=ollama/qwen3-coder
#
# AGENT_MODEL=
# AGENT_MODEL_VIC=

# Shipyard Inference gateway (preferred — your own stack)
# Cost-routing + failover across providers, usage/cost telemetry.
#   cd ~/projects/shipyard-inference && npx shipyard-gateway --config <config>
# SHIPYARD_INFERENCE_URL=http://127.0.0.1:8787/v1
# SHIPYARD_INFERENCE_API_KEY=dev-key

# Anthropic (https://console.anthropic.com/settings/api-keys)
# ANTHROPIC_API_KEY=

# Nous Research — OpenAI-compatible (or any compatible endpoint via NOUS_BASE_URL)
# NOUS_API_KEY=
# NOUS_BASE_URL=https://inference-api.nousresearch.com/v1

# ── Paybox (non-custodial x402 wallet) ─────────────────────────────
# Connect with `npx @paybox-sh/sdk login`, then either keep the config file
# (~/.config/paybox/config.json, local dev) or set these env vars (Vercel).
# PAYBOX_API_KEY=
# PAYBOX_SIGNING_KEY=
# PAYBOX_BASE_URL=https://api.paybox.sh
# PAYBOX_NETWORK=mainnet
# PAYBOX_WALLET_ID=
# PAYBOX_MAX_PAYMENT_USDC=1

# ── OpenClaw Gateway ─────────────────────────────────────────────
# Your local OpenClaw agent runtime. Run `openclaw gateway status` to find these.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# ── Ollama / Local Models ────────────────────────────────────────
# For running local LLMs via Ollama, LM Studio, or llama.cpp
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# ── Agent Delivery ───────────────────────────────────────────────
# Where agents send task notifications (telegram, discord, signal, whatsapp)
AGENT_DELIVERY_CHANNEL=telegram
AGENT_DELIVERY_TARGET=

# ── Agent Workspace ──────────────────────────────────────────────
# Directory where agent files live (memory, reports, identity docs)
AGENT_WORKSPACE=~/clawd

# ── Mission Control URL ──────────────────────────────────────────
# Public URL for agent callbacks (use localhost for dev)
NEXT_PUBLIC_MC_URL=http://localhost:3000

# ── Optional: Cost Tracking ──────────────────────────────────────
# Anthropic Admin API key for real usage/cost data
# Get yours at: https://console.anthropic.com/settings/admin-keys
# ANTHROPIC_ADMIN_KEY=sk-ant-admin-...

# ── Optional: GitHub Integration ─────────────────────────────────
# Personal access token for private repo access on /projects page
# GITHUB_TOKEN=ghp_...

# ── Optional: Google Calendar ────────────────────────────────────
# Google account email for calendar integration via gog CLI
# GOG_ACCOUNT=you@gmail.com
